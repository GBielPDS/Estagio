# Copie para .env; nunca compartilhe o arquivo com chaves reais no Git.
# reCAPTCHA v2 (caixa Não sou um robô). 0 = desligado; 1 = obrigatório nos dois logins.
GESTSAUDE_RECAPTCHA_ATIVO=0
GESTSAUDE_RECAPTCHA_SITE_KEY=
GESTSAUDE_RECAPTCHA_SECRET_KEY=
# Domínios sem protocolo, caminho ou porta; separados por vírgula.
GESTSAUDE_RECAPTCHA_HOSTNAMES=localhost